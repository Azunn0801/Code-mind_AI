# Copy this file to .env. Do not commit .env or reuse this password in a public deployment.
APP_ENV=local
APP_NAME=CodeMind API
API_PREFIX=/v1
AUTH_MODE=demo
CORS_ORIGINS=http://localhost:5173
CODE_RUNNER_MODE=simulated
AI_MODE=canned
AI_MAX_INTERACTIONS_PER_SESSION=3

# The direct local profile keeps its state in a private JSON file.
REPOSITORY_MODE=file
STATE_FILE_PATH=.data/codemind_state.json

# These values are required by docker compose. Use a URL-safe password (letters,
# digits, underscore or hyphen) because compose derives DATABASE_URL from it.
POSTGRES_DB=codemind
POSTGRES_USER=codemind
POSTGRES_PASSWORD=replace_with_a_unique_local_password
API_PORT=8765

# Only needed when REPOSITORY_MODE=postgres is started outside docker compose.
DATABASE_URL=postgresql+psycopg://codemind:replace_with_a_unique_local_password@localhost:5432/codemind
